{
  "name": "linkstead",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "vite build --config src/ui/vite.config.ts",
    "check-types": "tsc --noEmit && tsc --noEmit -p src/ui",
    "commitlint": "commitlint --edit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply linkstead --local",
    "db:migrate:remote": "wrangler d1 migrations apply linkstead --remote",
    "deploy": "pnpm build:ui && wrangler deploy",
    "dev": "wrangler dev",
    "dev:ui": "vite --config src/ui/vite.config.ts",
    "lint:check": "biome check .",
    "lint:fix": "ultracite fix",
    "prepare": "husky",
    "test": "vitest run"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,md}": [
      "ultracite fix"
    ]
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "lucide-react": "^1.73.0",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "swagger-ui-dist": "^5.35.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "jsqr": "^1.4.0",
    "lint-staged": "^17.6.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "7.10.4",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0"
    }
  }
}
