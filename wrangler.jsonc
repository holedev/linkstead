{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ou-link",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    // The built UI: `dist/client/app/**`, so its files are served under `/app`.
    "directory": "./dist/client",
    "binding": "ASSETS",
    // The Worker answers everything except the UI's hashed files. Left to the default, a Link's
    // address would be looked up among the files before the Worker ever saw it.
    "run_worker_first": ["/*", "!/app/assets/*"]
  },
  // Logo files for QR. Create it once with `wrangler r2 bucket create ou-link-logos`.
  "r2_buckets": [{ "binding": "LOGOS", "bucket_name": "ou-link-logos" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ou-link",
      // The trial database (APAC). An id is an address, not a secret - access is the account's.
      "database_id": "5c8c803a-6c94-4454-a743-35d81e6490c0",
      "migrations_dir": "migrations"
    }
  ]
}
