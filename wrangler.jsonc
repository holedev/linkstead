{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ou-link",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ou-link",
      // The trial database (APAC). An id is an address, not a secret - access is the account's.
      "database_id": "5c8c803a-6c94-4454-a743-35d81e6490c0",
      "migrations_dir": "migrations"
    }
  ]
}
