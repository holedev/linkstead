# The setup code: the first-run screen asks for it before creating the first System
# Administrator, so nobody who reaches a fresh installation first can take it. Choose a long,
# random value. Once the first administrator exists it opens nothing but the import of an export.
BOOTSTRAP_TOKEN=

# Optional. A Google Safe Browsing API key: destinations are checked when set and again daily.
# SAFE_BROWSING_KEY=

# Optional, together with the VISIT_EVENTS binding in wrangler.jsonc: visits through Workers
# Analytics Engine. CF_API_TOKEN needs Account -> Account Analytics -> Read.
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
